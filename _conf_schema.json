{
    "send": {
        "description": "发送配置",
        "type": "object",
        "items": {
            "media": {
                "description": "发送图片 & 视频",
                "hint": "每日天文图的主体媒体；视频期发送视频，平台不支持时退化为文字+链接",
                "type": "bool",
                "default": true
            },
            "title": {
                "description": "发送标题",
                "hint": "展示当期标题；有译文时显示「译文（原文）」",
                "type": "bool",
                "default": true
            },
            "explanation": {
                "description": "发送说明",
                "hint": "官方说明通常比较长，包含丰富的科学信息",
                "type": "bool",
                "default": true
            },
            "date": {
                "description": "发送日期",
                "hint": "展示当期日期（NASA 按美东时间发布）",
                "type": "bool",
                "default": true
            }
        }
    },
    "is_divided": {
        "description": "分开发送图片和文本",
        "hint": "开启后图片与正文分为两条消息发送",
        "type": "bool",
        "default": true
    },
    "translate": {
        "description": "翻译配置",
        "type": "object",
        "items": {
            "title": {
                "description": "翻译标题",
                "hint": "标题翻译为简体中文；不可译时保留原文",
                "type": "bool",
                "default": true
            },
            "explanation": {
                "description": "翻译说明",
                "hint": "说明翻译为简体中文",
                "type": "bool",
                "default": true
            },
            "provider": {
                "description": "翻译所使用的 LLM 提供商",
                "hint": "留空时使用当前对话模型进行翻译",
                "_special": "select_provider",
                "type": "string",
                "default": ""
            },
            "parse_retry": {
                "description": "翻译解析失败重试",
                "hint": "未按标签结构返回时，带上纠正提示再试一次；仍失败则展示原文",
                "type": "bool",
                "default": true
            }
        }
    },
    "push": {
        "description": "推送/订阅配置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用推送",
                "hint": "获取上游 RSS 更新并推送到已订阅会话",
                "type": "bool",
                "default": true
            },
            "mode": {
                "description": "推送模式",
                "type": "string",
                "options": ["scheduled", "upstream"],
                "labels": ["定时推送", "上游更新推送"],
                "default": "scheduled"
            },
            "push_time": {
                "description": "定时推送时间（HH:MM）",
                "hint": "仅定时推送模式生效，按服务器本地时区；已推送过的内容不会重复推送",
                "type": "string",
                "default": "01:00"
            },
            "interval_minutes": {
                "description": "轮询周期（分钟）",
                "hint": "仅上游更新推送模式生效，最小 5 分钟",
                "type": "int",
                "default": 30
            },
            "sessions": {
                "description": "推送/订阅名单 (UMO)",
                "hint": "格式 platform:message_type:session_id；可在会话中发送 /apod管理 订阅 或 /apod管理 退订 管理",
                "type": "list",
                "default": []
            },
            "translate": {
                "description": "（旧）推送前翻译",
                "type": "bool",
                "default": true,
                "invisible": true
            },
            "send_image": {
                "description": "（旧）推送附带图片",
                "type": "bool",
                "default": true,
                "invisible": true
            }
        }
    },
    "timeout": {
        "description": "请求超时时间（秒）",
        "type": "int",
        "default": 120
    },
    "retry_count": {
        "description": "网络获取失败时的重试次数",
        "hint": "0 表示不重试",
        "type": "int",
        "default": 3
    },
    "apod_cache_limit": {
        "description": "APOD 缓存条数上限",
        "hint": "翻译与图片缓存各自保留的上限，超出按写入顺序淘汰最旧；0 表示不限制；/apod管理 清理 可手动清空",
        "type": "int",
        "default": 1000
    },
    "cache_images": {
        "description": "缓存图片",
        "hint": "把图片下载到本地复用，避免每次发送重复下载",
        "type": "bool",
        "default": true
    },
    "prefetch": {
        "description": "定时预缓存",
        "hint": "APOD 更新后自动抓取内容并缓存；若开启翻译则会进行翻译，响应更快",
        "type": "bool",
        "default": false
    },
    "image": {
        "description": "（旧）发送图片",
        "type": "bool",
        "default": true,
        "invisible": true
    },
    "title": {
        "description": "（旧）标题配置",
        "type": "object",
        "invisible": true,
        "items": {
            "is_show": {"type": "bool", "default": true},
            "is_translate": {"type": "bool", "default": true}
        }
    },
    "explanation": {
        "description": "（旧）说明配置",
        "type": "object",
        "invisible": true,
        "items": {
            "is_show": {"type": "bool", "default": true},
            "is_translate": {"type": "bool", "default": true}
        }
    },
    "date": {
        "description": "（旧）日期配置",
        "type": "object",
        "invisible": true,
        "items": {
            "is_show": {"type": "bool", "default": true}
        }
    },
    "provider": {
        "description": "（旧）翻译所使用的 LLM 提供商",
        "type": "string",
        "default": "",
        "invisible": true
    },
    "translate_cache_limit": {
        "description": "（旧）翻译缓存条数上限",
        "type": "int",
        "default": 1000,
        "invisible": true
    }
}
