{
    "image": {
        "description": "是否发送图片",
        "hint": "NASA每日一图的标志性内容，建议开启",
        "type": "bool",
        "default": true
    },
    "explanation": {
        "description": "图片说明",
        "type": "object",
        "items": {
            "is_show": {
                "hint": "官方说明通常比较长，包含丰富的科学信息",
                "description": "是否发送NASA官方的图片说明",
                "type": "bool",
                "default": true
            },
            "is_translate": {
                "hint": "原文一般是英文",
                "description": "是否翻译说明为简体中文",
                "type": "bool",
                "default": true
            }
        }
    },
    "title": {
        "description": "标题配置",
        "type": "object",
        "items": {
            "is_show": {
                "description": "是否发送标题",
                "type": "bool",
                "default": true
            },
            "is_translate": {
                "description": "是否翻译标题",
                "type": "bool",
                "default": true
            }
        }
    },
    "provider": {
        "hint": "如果启用了翻译功能但未配置提供商，将无法进行翻译并可能导致错误日志",
        "description": "翻译所使用的LLM提供商",
        "_special": "select_provider",
        "type": "string"
    },
    "date": {
        "description": "日期配置",
        "type": "object",
        "items": {
            "is_show": {
                "description": "是否发送日期",
                "type": "bool",
                "default": true
            }
        }
    },
    "is_divided": {
        "description": "是否分开发送图片和文本内容",
        "type": "bool",
        "default": true
    },
    "push": {
        "description": "推送/订阅配置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用推送",
                "hint": "获取上游 RSS 更新并推送到已订阅会话",
                "type": "bool",
                "default": true
            },
            "mode": {
                "description": "推送模式",
                "type": "string",
                "options": ["scheduled", "upstream"],
                "labels": ["定时推送", "上游更新推送"],
                "default": "scheduled"
            },
            "push_time": {
                "description": "定时推送时间（HH:MM）",
                "hint": "仅定时推送模式生效，按服务器本地时区；已推送过的内容不会重复推送",
                "type": "string",
                "default": "01:00"
            },
            "interval_minutes": {
                "description": "轮询周期（分钟）",
                "hint": "仅上游更新推送模式生效，最小 5 分钟",
                "type": "int",
                "default": 30
            },
            "sessions": {
                "description": "推送/订阅名单 (UMO)",
                "hint": "格式 platform:message_type:session_id；可在会话中发送 /apod 订阅 或 /apod 退订 管理",
                "type": "list",
                "default": []
            },
            "translate": {
                "description": "推送前翻译",
                "hint": "翻译标题与解说，使用插件配置的 provider 或 AstrBot 默认对话模型",
                "type": "bool",
                "default": true
            },
            "send_image": {
                "description": "推送附带图片",
                "type": "bool",
                "default": true
            }
        }
    },
    "timeout": {
        "description": "请求超时时间（秒）",
        "type": "int",
        "default": 120
    },
    "retry_count": {
        "description": "获取失败时的重试次数",
        "type": "int",
        "default": 2
    }
}
